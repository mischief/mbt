.Sh NAME
.Nm mbt_ev_new_default ,
.Nm mbt_ev_sd_new ,
.Nm mbt_ev_sd_new_from ,
.Nm mbt_ev_libevent_new ,
.Nm mbt_ev_libevent_new_from ,
.Nm mbt_ev_run ,
.Nm mbt_ev_stop ,
.Nm mbt_ev_destroy ,
.Nm mbt_ev_io_new ,
.Nm mbt_ev_io_mod ,
.Nm mbt_ev_io_free ,
