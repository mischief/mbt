.Dd June 9, 2026
.Dt MBT_RATELIMIT 3
.Os
.Sh NAME
.Nm mbt_ratelimit_new ,
.Nm mbt_ratelimit_free ,
.Nm mbt_torrent_set_upload_rate ,
.Nm mbt_torrent_set_download_rate ,
.Nd token bucket rate limiting for bandwidth control
.Sh SYNOPSIS
.In mbt/ratelimit.h
.Ft int
.Fn mbt_ratelimit_new "struct mbt_torrent *t" "uint64_t bytes_per_sec"
.Ft void
.Fn mbt_ratelimit_free "struct mbt_session *s"
.Sh DESCRIPTION
A token bucket limiter enforcing per-torrent or session bandwidth caps.

.Pp
Fn mbt_ratelimit_new
creates a bucket filling at
Fa bytes_per_sec .
Callers consume tokens at request time; the bucket refills continuously
allowing smooth pacing across varying transfer rates.
.Sh RETURN VALUES
Fn mbt_ratelimit_new
returns 0 on success or negative errno if the rate value is invalid.
.Sh SEE ALSO
.Xr mbt_torrent 3 ,
.Xr mbt_session 3
