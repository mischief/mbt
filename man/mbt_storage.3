.Nd Storage backends for torrent data.
.Sh SYNOPSIS
.In mbt/storage.h
.Ft struct mbt_storage *
.Fn mbt_storage_new "const struct mbt_storage_ops *ops" "void *ctx"
.Ft struct mbt_storage *
.Fn mbt_storage_ref "struct mbt_storage *s"
.Ft void
.Fn mbt_storage_unref "struct mbt_storage *s"
.Ft struct mbt_storage *
.Fn mbt_storage_file_new "const char *data_dir"
.Ft struct mbt_storage_memory *
.Fn mbt_storage_memory_new
.Ft void
.Fn mbt_storage_memory_destroy "struct mbt_storage_memory *m"
.Ft struct mbt_storage *
.Fn mbt_storage_memory_storage "struct mbt_storage_memory *m"
.Ft int
.Fn mbt_storage_memory_put_file "struct mbt_storage_memory *m" "uint64_t offset" "const void *data" "size_t len"
.Ft int
.Fn mbt_storage_memory_get_file "struct mbt_storage_memory *m" "uint64_t offset" "void *buf" "size_t len"
.Ft uint8_t *
.Fn mbt_storage_memory_data "struct mbt_storage_memory *m"
